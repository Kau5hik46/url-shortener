import pool from '../db';
import { generateShortCode } from '../utils/hash';
import { setCache, getCache } from '../utils/cache';

export async function shortenUrl(originalUrl: string) {
    const shortCode = generateShortCode(originalUrl);
    await pool.query(
        'INSERT INTO urls (original_url, short_code) VALUES ($1, $2) ON CONFLICT DO NOTHING',
        [originalUrl, shortCode]
    );
    return shortCode;
}

export async function getOriginalUrl(shortCode: string): Promise<string | null> {
    const cachedUrl = await getCache(shortCode);
    if (cachedUrl) return cachedUrl;

    const result = await pool.query('SELECT original_url FROM urls WHERE short_code = $1', [shortCode]);
    if (result.rowCount > 0) {
        const originalUrl = result.rows[0].original_url;
        await setCache(shortCode, originalUrl, 3600); // Cache for 1 hour
        return originalUrl;
    }

    return null;
}